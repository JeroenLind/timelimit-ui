# Debug Server Environment Configuration
# Copy this file to .env and fill in the values

# Required - Must be set
SECRET_KEY=your-secret-key-here-min-32-chars

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT / Authentication settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Security settings
BCRYPT_COST=12
ENABLE_HTTPS=False

# Mock data settings
MOCK_DATA_SEED=42
MOCK_FAMILY_COUNT=1
MOCK_CHILD_COUNT=2
MOCK_DEVICE_COUNT=3
MOCK_CATEGORY_COUNT=3
MOCK_APP_COUNT=10

# WebSocket settings
ENABLE_WEBSOCKET=True
LONGPOLL_TIMEOUT_SECONDS=25

# Rate limiting settings
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Test mode settings
TEST_MODE=False

# Logging settings
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/debug-server.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# Message logging settings (for outgoing message logging)
MESSAGE_LOGGING_ENABLED=True
MESSAGE_LOGGING_ASYNC=True
MESSAGE_LOGGING_LEVEL=INFO
MESSAGE_LOGGING_MAX_BUFFER_SIZE=1000
MESSAGE_LOGGING_SANITIZE=True

# Log retention settings
# Maximum number of log files to retain on server startup (default: 10)
MAX_LOG_FILES=10