{
  "name": "Sync Flow",
  "description": "Test the sync flow: push-actions → pull-status → apply",
  "steps": [
    {
      "step": 1,
      "name": "Push Actions",
      "endpoint": "POST /sync/push-actions",
      "request": {
        "deviceAuthToken": "string",
        "actions": [
          {
            "type": "AddCategoryAction",
            "sequenceNumber": 1,
            "integrity": "password:base64encoded",
            "userId": "user_123",
            "encodedAction": "{\"categoryId\":\"cat_123\",\"title\":\"Games\",\"childId\":\"user_456\"}"
          }
        ]
      },
      "expected_response": {
        "status": "ok",
        "shouldDoFullSync": false,
        "processedCount": 1,
        "totalCount": 1
      }
    },
    {
      "step": 2,
      "name": "Pull Status",
      "endpoint": "POST /sync/pull-status",
      "request": {
        "deviceAuthToken": "string",
        "status": {
          "clientLevel": 7,
          "devices": "v1",
          "users": "v1",
          "apps": {},
          "devicesDetail": {},
          "categories": {},
          "kri": 0,
          "kr": 0,
          "dh": "v1",
          "u2f": "v1"
        }
      },
      "expected_response": {
        "status": "ok",
        "data": {
          "devices": {
            "v": "v1",
            "data": {}
          },
          "users": {
            "v": "v1",
            "data": {}
          },
          "apps": [],
          "rmCategories": [],
          "categoryBase": [],
          "categoryApp": [],
          "usedTimes": [],
          "rules": [],
          "tasks": [],
          "krq": [],
          "kr": [],
          "pings": [],
          "dh": {
            "v": "v1",
            "k": ""
          },
          "u2f": {
            "v": "v1",
            "d": []
          },
          "fullVersion": 0,
          "message": "",
          "apiLevel": 1
        }
      }
    },
    {
      "step": 3,
      "name": "Report Removed",
      "endpoint": "POST /sync/report-removed",
      "request": {
        "deviceAuthToken": "string"
      },
      "expected_response": {
        "status": "ok"
      }
    },
    {
      "step": 4,
      "name": "Is Device Removed",
      "endpoint": "POST /sync/is-device-removed",
      "request": {
        "deviceAuthToken": "string"
      },
      "expected_response": {
        "status": "ok",
        "isDeviceRemoved": true
      }
    }
  ],
  "validation": {
    "assertions": [
      "Actions are stored with correct sequence numbers",
      "ServerDataStatus contains all required fields",
      "Device auth token is validated for protected endpoints",
      "Full sync flag is returned when appropriate"
    ]
  }
}